# Keep research conclusions, research paths, evidence tables and figures in Git.
# These rules are path/type based; .gitignore cannot filter by file size.

# Model weights and training checkpoints (not *.safetensors.index.json).
*.safetensors
*.bin
*.pt
*.pth
*.ckpt
*.gguf
*.ggml
*.onnx
*.h5
*.hdf5

# Generated per-request predictions and evaluation shards.
# Research source examples outside report/artifact bundles remain versioned.
/artifacts/**/*.jsonl
/reports/**/*.jsonl
results.jsonl
part-*.jsonl
predictions*.jsonl

# Bulk dataset/cache containers, not small CSV/JSON report tables or indexes.
*.arrow
*.parquet
*.npz
/cache/

# Python caches and local environments.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.venv/
venv/
/envs/
.ipynb_checkpoints/

# Runtime locks and incomplete transfers; preserve logs and dependency locks.
watcher.lock
*.pid
*.sock
*.tmp
*.partial
*.part
.*.incoming-*/

# Operating-system metadata.
.DS_Store
.AppleDouble/
._*

# Local credentials; sanitized environment examples may be committed.
.env
.env.*
!.env.example
!.env.sample
.secrets/
.ssh/
id_rsa
id_ed25519

# Research-library policy: execution assets live in the sibling auxiliary archive.
*.py
*.sh
*.cjs
*.log
*.lock
*.npy
*.npz
*.zip
*.tar.gz
*.jinja
tokenizer.json
tokenizer_config.json
vocab.json
merges.txt
added_tokens.json
special_tokens_map.json
requirements*.txt
*.jsonl

# Exception to the policy above (user request, 2026-11-12): the attention-mask patch keeps
# its module, patched scripts and CPU checks next to its note.
!/02-研究路径/05-Attention与效率/2026-11-10-attention-mask-modes/code/**/*.py
